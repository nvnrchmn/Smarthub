# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smarthub_dev?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/smarthub_test?schema=public"

# Auth
JWT_SECRET="ganti-dengan-secret-minimal-32-karakter"
JWT_EXPIRES_IN="8h"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# API
# Produksi (smarthub.logikraf.id):
#   CORS_ORIGIN="https://smarthub.logikraf.id"
#   PUBLIC_API_URL="https://smarthub.logikraf.id"
#   PUBLIC_WEB_URL="https://smarthub.logikraf.id"
#   API_BASE_URL="https://smarthub.logikraf.id/api/v1"
# Webhook Hub diarahkan ke https://smarthub.logikraf.id/api/v1/billing/webhook
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
UPLOAD_DIR="uploads"
PUBLIC_API_URL="http://localhost:4000"
PUBLIC_WEB_URL="http://localhost:3000"
MAX_UPLOAD_SIZE_MB=5

# Web (BFF)
API_BASE_URL="http://localhost:4000/api/v1"
AUTH_COOKIE_NAME="smarthub_token"
REFRESH_AUTH_COOKIE_NAME="smarthub_refresh_token"
PLATFORM_AUTH_COOKIE_NAME="smarthub_platform_token"

# Backup (hanya dipakai skrip apps/api/scripts/backup-db.sh & restore-db.sh)
BACKUP_ENCRYPTION_KEY="ganti-dengan-kunci-enkripsi-panjang"
BACKUP_DIR="./backups"
RETENTION_DAYS=14

# Logikraf Payment Hub (opsional). Kosongkan bila QRIS iuran belum diaktifkan;
# endpoint /api/v1/billing akan mengembalikan 503.
# Produksi: LOGIKRAF_HUB_BASE_URL="https://logikraf.id"
LOGIKRAF_HUB_BASE_URL=""
LOGIKRAF_HUB_API_KEY=""
LOGIKRAF_HUB_WEBHOOK_SECRET=""
# Kunci internal Hub (header X-Internal-Key); dipakai untuk panggilan keluar (client store)
# DAN untuk memverifikasi permintaan masuk dari Hub ke Internal Finance API SmartHub.
LOGIKRAF_INTERNAL_API_KEY=""
# true = alur KYC/QRIS/payout berjalan dengan respons sintetis (tanpa Hub/penyedia)
LOGIKRAF_HUB_MOCK=false
# Ketahanan klien Hub (hardening): timeout per panggilan, jumlah retry untuk 5xx/timeout, jeda dasar antar-retry
LOGIKRAF_HUB_TIMEOUT_MS=10000
LOGIKRAF_HUB_RETRY=2
LOGIKRAF_HUB_RETRY_DELAY_MS=200
# MDR ditanggung RT (dipotong dari saldo sub-akun); HUB_FEE_PERSEN hanya referensi internal
HUB_FEE_PERSEN=2
MDR_PERSEN=0.7

# Kanal notifikasi (opsional; kosong = mode dry, pesan tidak benar-benar terkirim)
GOWA_BASE_URL=""
GOWA_API_KEY=""
BILLIONMAIL_BASE_URL=""
BILLIONMAIL_API_KEY=""
BILLIONMAIL_FROM="no-reply@smarthub.local"

# Worker internal (scheduler interval, tanpa Redis)
WORKERS_ENABLED=false
WORKER_INTERVAL_MS=30000
